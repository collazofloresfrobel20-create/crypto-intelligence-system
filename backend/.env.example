# Base de datos: deja TURSO_DATABASE_URL vacio para usar SQLite local (modo desarrollo).
# Ponlo (junto con TURSO_AUTH_TOKEN) para usar una base Turso remota (necesario en GitHub
# Actions, ya que cada corrida es una maquina desechable sin disco persistente). Crea una
# base gratis en https://turso.tech -> `turso db create cis` -> `turso db show cis --url` ->
# `turso db tokens create cis`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Consigue una API key gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional pero MUY recomendado: la cuota gratuita diaria del modelo "smart" (Bull/Bear/
# Mediador/Juez) es de solo 20 llamadas/dia POR PROYECTO de Google Cloud (confirmado en
# produccion). Con 1 key = ~5 tokens analizados/dia. Cada key aqui debe venir de un proyecto
# de Google Cloud DISTINTO (aistudio.google.com/apikey -> "Create API key in new project") --
# varias keys del MISMO proyecto NO ayudan, comparten la misma cuota. Con 3 keys en total
# (GEMINI_API_KEY + 2 aqui) cubres 15 tokens/dia. Separadas por coma, sin espacios.
GEMINI_SMART_API_KEYS=

# No uses los alias "-latest": pueden apuntar a un modelo recien lanzado con cuota gratuita
# de lanzamiento muy baja (nos pasó con gemini-3.7-flash: solo 20 solicitudes/dia). Usa
# nombres de modelo fijos y establecidos.
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_SMART=gemini-3.5-flash
GEMINI_MAX_RPM=12
GEMINI_MAX_RPD=1400

# Hard filters (Discovery -> candidatos tempranos)
MIN_LIQUIDITY_USD=50000
MIN_VOLUME_24H_USD=100000
MAX_MARKET_CAP_USD=50000000
MIN_HOLDERS=200
MAX_LISTING_AGE_DAYS=120

MAX_CANDIDATES_PER_RUN=15
PREDICTION_HORIZON_DAYS=7

# Opcional: sube el rate limit de GoPlus (no requerido para el MVP)
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# Acceso privado (unico usuario/contraseña, no es un sistema de cuentas multiusuario)
AUTH_USERNAME=cambiar-usuario
AUTH_PASSWORD=cambiar-password
# Bloqueo tras N intentos fallidos de login, por IP (o CF-Connecting-IP si esta detras de Cloudflare)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Actualizacion automatica: corre run_update_cycle() sola cada N horas, sin depender de que
# alguien le de clic al boton. El primer ciclo arranca ~60s despues de iniciar el servidor.
AUTO_UPDATE_ENABLED=true
AUTO_UPDATE_INTERVAL_HOURS=12

# Alertas por Telegram (opcional). Deja vacio si no las quieres: el sistema simplemente no
# manda nada. Para conseguir los valores:
#   1. En Telegram, busca @BotFather y mandale /newbot. Te da un token.
#   2. Mandale cualquier mensaje a tu bot recien creado.
#   3. Abre https://api.telegram.org/bot<TU_TOKEN>/getUpdates y busca "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Veredictos que disparan una alerta (separados por coma)
TELEGRAM_NOTIFY_VERDICTS=Strong Opportunity
